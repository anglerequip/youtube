# Copy to .env and fill in. .env is git-ignored: never commit real keys.

# --- Branding -------------------------------------------------------------
CHANNEL_NAME=Counterphysical
CHANNEL_TAGLINE=physics that breaks your intuition.

# --- Voice ----------------------------------------------------------------
# kokoro (free, local, default) | elevenlabs (paid) | dummy (tests only)
TTS_PROVIDER=kokoro
KOKORO_VOICE=af_bella
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# --- Rendering ------------------------------------------------------------
FPS=30
MIN_SECONDS=61   # Caesar's rule: every video over 60 s (TikTok Creator Rewards)
MAX_SECONDS=90

# --- Telegram approval bot (Phase 4) -----------------------------------------
# Create a bot with @BotFather, then message it once and read your chat id.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Publishing (docs/PUBLISHING.md) ---------------------------------------
# AI-generated labels on every platform (recommended: keep true)
# AI_LABEL=true

# YouTube: OAuth client file from Google Cloud Console (Desktop app). Keep it out of git.
# YOUTUBE_CLIENT_SECRETS=client_secret.json
# YOUTUBE_TOKEN_FILE=data/tokens/youtube.json
# YOUTUBE_PRIVACY=public          # public | unlisted | private

# TikTok: developers.tiktok.com app with Login Kit + Content Posting API (Direct Post)
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_REDIRECT_URI=
# TIKTOK_PRIVACY=PUBLIC_TO_EVERYONE   # unaudited apps can only post SELF_ONLY (private)

# Facebook Reels: a Page, and a long-lived Page access token with pages_manage_posts
# FACEBOOK_PAGE_ID=
# FACEBOOK_PAGE_TOKEN=
# FACEBOOK_GRAPH_VERSION=v21.0

# --- LLM for automatic ideas/scripts (optional, Phase 3) ------------------
# manual (default, $0: a Claude Code session writes storyboards) | anthropic (paid API) | ollama (free, local)
# LLM_PROVIDER=manual
# ANTHROPIC_API_KEY=
# OLLAMA_MODEL=qwen2.5:14b
