# Copy to .env and fill in. .env is git-ignored: never commit real keys.

# --- Branding -------------------------------------------------------------
CHANNEL_NAME=Counterphysical
CHANNEL_TAGLINE=physics that breaks your intuition.

# --- Voice ----------------------------------------------------------------
# kokoro (free, local) | elevenlabs (paid) | dummy (tests only)
# Channel narrator (Caesar, 2026-11-20): ElevenLabs voice TWutjvRaJqAX89preB4e, replacing Kokoro af_bella.
# Kokoro stays as the free fallback: set TTS_PROVIDER=kokoro to use it.
TTS_PROVIDER=elevenlabs
KOKORO_VOICE=af_bella
# ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=TWutjvRaJqAX89preB4e
# Presenter voices for two-character (DUO) episodes, docs/styles/DUO.md (Caesar, 2026-11-20)
ELEVENLABS_VOICE_MAN=3iY0r3RaYmOh6WfIwMIH
ELEVENLABS_VOICE_WOMAN=vChnJZ1Cu89g2XXumPfT

# --- Rendering ------------------------------------------------------------
FPS=30
MIN_SECONDS=15   # Caesar (2026-11-19): length follows the story, typically 18-45 s
MAX_SECONDS=60   # up to 60 s only when the story earns it

# --- Telegram approval bot (Phase 4) -----------------------------------------
# Create a bot with @BotFather, then message it once and read your chat id.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- YouTube (Phase 5) ----------------------------------------------------
# OAuth client file from Google Cloud Console (Desktop app). Keep it out of git.
# YOUTUBE_CLIENT_SECRETS=client_secret.json
# YOUTUBE_TOKEN_FILE=data/youtube_token.json
# private until Google approves the API project's audit; then public/unlisted
# YOUTUBE_DEFAULT_PRIVACY=private

# --- LLM for automatic ideas/scripts (optional, Phase 3) ------------------
# manual (default, $0: a Claude Code session writes storyboards) | anthropic (paid API) | ollama (free, local)
# LLM_PROVIDER=manual
# ANTHROPIC_API_KEY=
# OLLAMA_MODEL=qwen2.5:14b
